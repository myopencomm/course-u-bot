# ═══════════════════════════════════════════════════════════════════════════
#  course-u-bot — configuration
#  Copiez ce fichier en « .env » puis remplissez-le. Le .env n'est JAMAIS publié.
#  Le plus simple : lancez « npm run setup », qui le crée en vous posant les
#  questions une par une.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Compte Super U (obligatoire) ───────────────────────────────────────────
COURSESU_EMAIL=votre.email@exemple.fr
COURSESU_PASSWORD=votre-mot-de-passe

# Laissez vide : le bot reprend le magasin déjà sélectionné sur votre compte.
# À remplir seulement si vous jonglez entre plusieurs magasins.
# Exemple : drive-superu-nantes
COURSESU_STORE_PATH=

# ─── Code de connexion reçu par e-mail (obligatoire) ────────────────────────
# Super U envoie un code à 8 chiffres à chaque connexion. Le bot le lit dans la
# boîte mail, le saisit, puis SUPPRIME le message.
# Avec Gmail : créez un « mot de passe d'application » sur
# https://myaccount.google.com/apppasswords — ce n'est PAS le mot de passe du compte.
GMAIL_USER=votre.email@gmail.com
GMAIL_APP_PASSWORD=

# Autre fournisseur que Gmail : indiquez son serveur IMAP.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# ─── Notifications Telegram (facultatif) ────────────────────────────────────
# Identifiant de la conversation ou du groupe où envoyer le bilan.
# Laissez vide pour n'envoyer aucune notification. Voir docs/TELEGRAM.md.
TELEGRAM_TARGET=

# ─── Note Apple à lire (facultatif) ─────────────────────────────────────────
# Titre exact de la note, et titre de la section à l'intérieur de celle-ci.
NOTE_TITLE=Shopping List
NOTE_SECTION=PROCHAIN SUPERMARCH

# ─── Arbitrage par une IA en ligne de commande (fortement recommandé) ───────
# Sans lui le bot fonctionne, mais il pose nettement plus de questions.
# Préréglages disponibles : claude · gemini · ollama · codex
JUDGE_ENABLED=true
JUDGE_PRESET=claude
# JUDGE_MODEL=claude-sonnet-5
# Seuil de confiance au-dessus duquel le bot décide seul (0 à 1).
JUDGE_THRESHOLD=0.8
# Pour un CLI non prévu : la commande et ses arguments (tableau JSON).
# Marqueurs remplacés : {prompt} {system} {model}
# JUDGE_CMD=mon-cli
# JUDGE_ARGS=["-p","{system}\n\n{prompt}","--model","{model}"]
# JUDGE_OUTPUT=texte

# ─── Garde-fou de confidentialité ───────────────────────────────────────────
# Prénoms de votre foyer. « npm run check-privacy » refusera tout commit qui en
# contient — ils se glissent facilement dans un commentaire de code.
PRIVACY_NAMES=

# ─── Avancé ─────────────────────────────────────────────────────────────────
# CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_CDP_PORT=9222
# CHROME_PROFILE_DIR=
